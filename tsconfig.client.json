{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx/dom",
    "noEmit": true
  },
  "include": ["client/src/**/*.ts", "client/src/**/*.tsx", "src/api-types.ts"]
}
